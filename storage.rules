rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Profile photos directory: profilePhotos/{userId}/{uniqueFileId}
    match /profilePhotos/{userId}/{fileId} {
      // Readable by all signed-in users (and public discovery)
      allow read: if request.auth != null;
      
      // Upload/write allowed only by owner, max 5MB, image content type
      allow write: if request.auth != null 
                   && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');

      // Delete allowed only by owner or admin
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Legacy storage path support
    match /profile_photos/{userId} {
      allow read: if request.auth != null;
      allow write, delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
