rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.get('admin', false) == true ||
        (request.auth.token.email != null && request.auth.token.email.lower() == 'admin@glbitm.ac.in') ||
        (exists(/databases/$(database)/documents/config/admins) && (
          request.auth.uid in get(/databases/$(database)/documents/config/admins).data.get('uids', []) ||
          (request.auth.token.email != null && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/admins).data.get('adminEmails', []))
        ))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Public User Profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      
      allow create: if isOwner(userId) &&
        incoming().get('uid', '') == request.auth.uid &&
        (incoming().get('email', '').lower().endsWith('@glbitm.ac.in') || (request.auth.token.get('email', '') != null && request.auth.token.email.lower().endsWith('@glbitm.ac.in'))) &&
        incoming().get('isPriority', false) == false &&
        incoming().get('isAdmin', false) == false &&
        incoming().get('isVerified', false) == false &&
        incoming().get('isSuspended', false) == false;
      
      allow update: if isAdmin() || (
        isOwner(userId) &&
        !incoming().diff(existing()).affectedKeys().hasAny([
          'isPriority', 'priorityRank', 'priorityUpdatedAt', 'priorityUpdatedBy',
          'isAdmin', 'isVerified', 'isSuspended'
        ])
      );

      allow delete: if isAdmin();
    }

    // Private User Profiles (Strictly isolated - readable ONLY by owner or admin)
    match /usersPrivate/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Helper function for request creation
    function validRequestCreate() {
      return isSignedIn() &&
        // Must be sent by the authenticated user
        (incoming().get('senderUid', '') == request.auth.uid || incoming().get('senderId', '') == request.auth.uid) &&
        // Recipient must be a valid target (non-empty and not self)
        (incoming().get('recipientUid', '') != request.auth.uid && incoming().get('receiverId', '') != request.auth.uid) &&
        (incoming().get('recipientUid', '') != '' || incoming().get('receiverId', '') != '') &&
        // Initial status must be pending
        incoming().get('status', '') == 'pending' &&
        // Initial recipient contact sharing must be ungranted (false)
        incoming().get('recipientShareContacts', false) == false &&
        // Sender contact sharing can be true (consent granted on send) or false
        (incoming().get('senderShareContacts', false) == true || incoming().get('senderShareContacts', false) == false);
    }

    // Partner Requests
    match /requests/{requestId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        resource.data.get('senderId', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if validRequestCreate() || isAdmin();

      allow update: if isSignedIn() && (
        resource.data.get('recipientUid', '') == request.auth.uid ||
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('receiverId', '') == request.auth.uid ||
        resource.data.get('senderId', '') == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isSignedIn() && (
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('senderId', '') == request.auth.uid ||
        isAdmin()
      );
    }

    // Shared Contacts (Authorized contact exchange for partner requests)
    match /sharedContacts/{requestId} {
      allow read, write: if isSignedIn() && (
        resource == null ||
        resource.data.get('senderUid', '') == request.auth.uid ||
        resource.data.get('recipientUid', '') == request.auth.uid ||
        resource.data.get('ownerUid', '') == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/requests/$(requestId)) &&
          (
            get(/databases/$(database)/documents/requests/$(requestId)).data.get('senderUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.get('senderId', '') == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.get('recipientUid', '') == request.auth.uid ||
            get(/databases/$(database)/documents/requests/$(requestId)).data.get('receiverId', '') == request.auth.uid
          )
        ) || isAdmin()
      );

      // Subcollection: member-specific contact documents owned by memberUid
      match /members/{memberUid} {
        // Read allowed if request exists, status is accepted, and reading user is a participant in request
        allow read: if isSignedIn() && (
          (
            exists(/databases/$(database)/documents/requests/$(requestId)) &&
            (
              get(/databases/$(database)/documents/requests/$(requestId)).data.get('senderUid', '') == request.auth.uid ||
              get(/databases/$(database)/documents/requests/$(requestId)).data.get('senderId', '') == request.auth.uid ||
              get(/databases/$(database)/documents/requests/$(requestId)).data.get('recipientUid', '') == request.auth.uid ||
              get(/databases/$(database)/documents/requests/$(requestId)).data.get('receiverId', '') == request.auth.uid
            ) &&
            get(/databases/$(database)/documents/requests/$(requestId)).data.get('status', '') == 'accepted'
          ) ||
          memberUid == request.auth.uid ||
          isAdmin()
        );

        // Write allowed ONLY if current user is memberUid AND ownerUid equals request.auth.uid
        allow create, update: if isSignedIn() && (
          memberUid == request.auth.uid &&
          incoming().get('ownerUid', '') == request.auth.uid
        );

        allow delete: if isSignedIn() && (
          memberUid == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read, update, delete: if isSignedIn() && (
        resource.data.get('userId', '') == request.auth.uid ||
        isAdmin()
      );
      
      allow create: if isSignedIn();
    }

    // App Configuration
    match /config/{configDoc} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
